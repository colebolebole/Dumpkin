# Copy to keystore.properties (git-ignored) and fill in. Alternatively set the DUMPKIN_KEYSTORE_FILE,
# DUMPKIN_KEYSTORE_PASSWORD, DUMPKIN_KEY_ALIAS and DUMPKIN_KEY_PASSWORD environment variables.
storeFile=C:/Users/you/.dumpkin/dumpkin-release.jks
storePassword=change-me
keyAlias=dumpkin
keyPassword=change-me
