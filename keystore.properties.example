# Copy to keystore.properties (git-ignored) and fill in. Alternatively set the ANCRAFT_KEYSTORE_FILE,
# ANCRAFT_KEYSTORE_PASSWORD, ANCRAFT_KEY_ALIAS and ANCRAFT_KEY_PASSWORD environment variables.
storeFile=C:/Users/you/.ancraft/ancraft-release.jks
storePassword=change-me
keyAlias=ancraft
keyPassword=change-me
